# ==============================================================================
# MediMind AI — Environment Variables (EXAMPLE FILE)
# Copy this file to `.env` in the project root and fill in real values.
# NEVER commit the real .env file to git.
# ==============================================================================

# --- App ---
ENV=development
DEBUG=true

# --- Database ---
POSTGRES_USER=medimind
POSTGRES_PASSWORD=medimind
POSTGRES_DB=medimind_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medimind:medimind@db:5432/medimind_db

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- AI (added in later phases — placeholders only for now) ---
# LLM_API_KEY=
# LLM_MODEL=
